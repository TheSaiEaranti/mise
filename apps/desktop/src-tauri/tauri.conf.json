{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mise",
  "version": "0.1.0",
  "identifier": "com.sai.mise",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/out",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../web && TAURI_BUILD=1 bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mise",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"]
  }
}
