{
  "name": "mise",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*",
    "config"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "test": "bun test packages config apps/api",
    "typecheck": "tsc -p packages/core && tsc -p apps/api && bun run --cwd apps/web typecheck",
    "seed": "bun run scripts/seed.ts",
    "db:generate": "drizzle-kit generate --config packages/core/drizzle.config.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "setup": "bash scripts/setup.sh",
    "eval:latency": "bun run scripts/latency-eval.ts",
    "eval:compare": "bun run scripts/compare-latency.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "dev:demo": "MISE_DB_PATH=data/demo.db bun run scripts/dev.ts",
    "record:demo": "bun run scripts/record-demo.ts",
    "demo:api": "MISE_DB_PATH=data/demo.db bun apps/api/src/index.ts",
    "demo:web": "bun run --cwd apps/web build && bun run --cwd apps/web start",
    "demo:timing": "bun run scripts/demo-timing.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.30.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3"
  }
}
